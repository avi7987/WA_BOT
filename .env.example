# =====================================================================
#  העתק את הקובץ הזה ל-.env ומלא את הערכים.
#  הקובץ .env לא עולה לגיטהאב לעולם.
# =====================================================================

# ── Supabase (בסיס הנתונים) ─────────────────────────────────────────
# מתוך Supabase → Project Settings → API
SUPABASE_URL=https://xxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGci...

# ── מי אתם ──────────────────────────────────────────────────────────
# המספרים מזוהים אוטומטית מהוואטסאפ עצמו — צריך רק שמות.
OWNER_NAME=אבישי
PARTNER_NAME=איה

# האם להפעיל גם את הסשן של בת/בן הזוג (רשימה משותפת)
ENABLE_PARTNER=true

# ── בינה מלאכותית (הבנת עברית חופשית + תמלול הקלטות) ────────────────
# gemini  — מפתח חינמי מ-https://aistudio.google.com/apikey  (טקסט + תמלול, מפתח אחד)
# groq    — מפתח חינמי מ-https://console.groq.com/keys       (טקסט + Whisper)
# none    — בלי AI. הבוט עדיין עובד, אבל מבין רק ניסוח פשוט ולא מתמלל הקלטות.
LLM_PROVIDER=gemini
GEMINI_API_KEY=
# כינוי שמצביע תמיד על גרסת ה-Flash העדכנית — לא נשבר כשגוגל מחליפים דורות
GEMINI_MODEL=gemini-flash-latest
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_STT_MODEL=whisper-large-v3-turbo

# ── התנהגות ─────────────────────────────────────────────────────────
# שעת סיכום הבוקר (שעון ישראל)
DIGEST_TIME=08:00
# סיכום ערב קצר ("מה נשאר פתוח") — true/false
EVENING_DIGEST=false
EVENING_TIME=21:00
# חלון שעות שבו מותר לבוט לשלוח יזום (שעון ישראל)
QUIET_START=07:00
QUIET_END=22:30
TZ_NAME=Asia/Jerusalem

# ── הרצה ────────────────────────────────────────────────────────────
PORT=3000
# נתיב לשמירת החיבור לוואטסאפ (בענן — תיקייה עם דיסק קבוע)
WA_SESSION_PATH=./.wwebjs_auth
# בענן: נתיב ל-Chromium המותקן במערכת
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium
